## Copy to `.env.local` for local development.
## Do NOT commit real secrets.

# Postgres (Drizzle + `npm run seed:prompts`). Supabase: Settings → Database → URI (pooler ok).
DATABASE_URL=

# NextAuth (GitHub / Google / email-password). Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# GitHub OAuth — https://github.com/settings/developers → New OAuth App
# Homepage: NEXTAUTH_URL (e.g. http://localhost:3000)
# Callback: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth — Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Built-in admin (email + password / Credentials provider). Min 8 chars for password.
# Multiple admins: comma-separated emails (must match the address you sign in with exactly).
# - On server start: if this email does not exist yet, one row is created (instrumentation.ts + next.config experimental.instrumentationHook).
# - First credentials sign-in also runs bootstrap (covers serverless / missed instrumentation).
# - To create or reset password anytime: npm run seed:admin (required if this email already exists via OAuth without a password).
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change_me_8plus
ADMIN_NAME=Admin

# Public site URL (used for SEO/canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default image provider used when client selects `internal`
# Options: atlascloud | replicate
DEFAULT_IMAGE_PROVIDER=atlascloud

# Credits limits (ONLY enforced for internal mode; user-provided apiKey overrides bypass limits)
# Leave empty (or set to 0) for unlimited / disabled.
INTERNAL_DAILY_IMAGE_CREDITS=
INTERNAL_MONTHLY_IMAGE_CREDITS=

# Secret used to sign per-user credits cookie (required in production if any INTERNAL_*_CREDITS is set)
# Generate with: openssl rand -hex 32
CREDITS_COOKIE_SECRET=replace_with_random_hex

# Test mode (skip real providers)
USE_TEST_MODE=false
TEST_IMAGE_URL=https://example.com/test.png

## Atlascloud (image generation)
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1/model
ATLASCLOUD_API_KEY=your_atlascloud_api_key

## Replicate (image generation)
REPLICATE_API_TOKEN=your_replicate_api_token
# Provide either REPLICATE_MODEL or REPLICATE_VERSION
REPLICATE_MODEL=black-forest-labs/flux-schnell
# REPLICATE_VERSION=

## OpenAI (video / other features in this repo)
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_MODEL=sora-1.0-turbo
OPENAI_API_BASE_URL=https://api.openai.com

